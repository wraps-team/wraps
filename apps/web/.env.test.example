# Test environment, loaded by every vitest config (apps/web, apps/api,
# packages/auth, packages/db) via vite's loadEnv("test", "apps/web").
#
#   cp apps/web/.env.test.example apps/web/.env.test
#
# The non-secret values below mirror what .github/workflows/test.yml sets for the
# test jobs, so a local `pnpm test` sees the same configuration as CI. Without
# them the auth Stripe-config tests fail on missing keys.
#
# DATABASE_URL is the only secret. CI takes it from the TEST_DATABASE_URL repo
# secret. It is the shared Neon test-database *parent*; vitest rewrites it to
# this checkout's own branch (see docs/agents/test-database.md). Tests that hit
# the database (most of apps/api, packages/db, parts of apps/web) fail with
# "SASL: client password must be a string" until it is set.
# DATABASE_URL=postgresql://...   (uncomment and fill in; leave unset rather than empty)

BETTER_AUTH_SECRET=test-secret-key-for-testing-only
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_fake_key_for_ci_only
STRIPE_WEBHOOK_SECRET=whsec_fake_secret_for_ci_only
STRIPE_GROWTH_PRICE_ID=price_fake_growth_for_ci_only

# Optional: with both set, each checkout gets its own Neon branch instead of
# sharing the parent (docs/agents/test-database.md).
# NEON_API_KEY=
# NEON_PROJECT_ID=
