# Environment Variables for Next.js Website

# Database connection string (required for API endpoints like waitlist)
# Get this from your Neon dashboard
DATABASE_URL=

# Google Tag Manager ID (optional)
# Only set this in production deployments to enable analytics tracking
# Leave empty or omit for development/open-source usage
NEXT_PUBLIC_GTM_ID=

# Example for your production deployment:
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# PostHog Analytics (optional)
# Client-side tracking (NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Server-side API key for telemetry endpoint (CLI events)
POSTHOG_API_KEY=
POSTHOG_HOST=

# Example for your production deployment:
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://o11y.wraps.dev
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxx
# POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile (bot protection for tools pages)
# Get keys from: https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs the per-page /og share-card URLs (any random string, 32+ bytes in production).
# Unset: every page falls back to the shared /og-image.png.
OG_IMAGE_SECRET=
