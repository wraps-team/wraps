{
  "name": "@wraps/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic error reporting seam shared by apps/api, apps/web and packages/auth",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
