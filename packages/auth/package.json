{
  "name": "@wraps/auth",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "stripe listen --forward-to https://web.wraps.localhost/api/auth/stripe/webhook",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "vite": "^7.3.6",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-pinpoint-sms-voice-v2": "catalog:",
    "@better-auth/core": "1.7.11",
    "@better-auth/passkey": "1.7.11",
    "@better-auth/scim": "1.7.11",
    "@better-auth/sso": "1.7.11",
    "@better-auth/stripe": "1.7.11",
    "@better-auth/utils": "0.5.0",
    "@byo-oss/mailer": "catalog:",
    "@byo-oss/notifications": "catalog:",
    "@sentry/nextjs": "10.75.3",
    "@vercel/oidc-aws-credentials-provider": "3.0.4",
    "@wraps.dev/better-auth": "^0.4.0",
    "@wraps.dev/client": "0.12.1",
    "@wraps.dev/email": "^0.15.1",
    "@wraps.dev/sms": "^0.2.0",
    "@wraps/analytics": "workspace:*",
    "@wraps/db": "workspace:*",
    "@wraps/email": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  }
}
