{
  "name": "@wraps/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Pluggable AI inference providers for Wraps. Selects a provider from deployment env and maps portable model requests onto provider-native call options.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.118",
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/gateway": "4.0.116",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/provider-utils": "5.0.62",
    "@aws-sdk/credential-providers": "catalog:"
  },
  "devDependencies": {
    "ai": "7.0.143",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "ai": "7.0.143",
    "typescript": "catalog:"
  }
}
